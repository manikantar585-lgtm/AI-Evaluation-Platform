# Live model target (examples/targets/groq.json and the seeded "groq" target)
GROQ_API_KEY=

# LLM-as-a-judge metric (OpenAI-compatible)
JUDGE_API_KEY=
JUDGE_BASE_URL=https://api.groq.com/openai/v1
JUDGE_MODEL=llama-3.3-70b-versatile

# Embeddings for semantic_similarity (optional)
EMBED_API_KEY=
EMBED_BASE_URL=https://api.openai.com/v1
EMBED_MODEL=text-embedding-3-small

MAX_WORKERS=4
